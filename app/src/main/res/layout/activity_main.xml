<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#BFBFBF"
                android:minHeight="?attr/actionBarSize"
                android:theme="?attr/actionBarTheme"
                app:navigationIcon="@android:drawable/ic_dialog_info" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="67dp"
                android:text="CONECTAR BLUTU"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Display1" />

            <FrameLayout
                android:layout_width="380dp"
                android:layout_height="516dp"
                android:backgroundTint="#FFBEBE"
                android:backgroundTintMode="add">

                <Button
                    android:id="@+id/btnConectar"
                    android:layout_width="186dp"
                    android:layout_height="91dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="84dp"
                    android:backgroundTint="#E76F6F"
                    android:text="CONECTAR"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    app:iconTintMode="src_atop"
                    app:strokeColor="#E91010" />

                <Button
                    android:id="@+id/btnEnviar"
                    android:layout_width="101dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="412dp"
                    android:text="ENVIAR" />

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="350dp"
                    android:layout_height="106dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="200dp"
                    android:background="#EBEBEB"
                    android:text="123456LOL"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Large"
                    android:textSize="16sp"
                    android:typeface="monospace" />

                <EditText
                    android:id="@+id/etMensaje"
                    android:layout_width="226dp"
                    android:layout_height="73dp"
                    android:layout_marginStart="140dp"
                    android:layout_marginTop="412dp"
                    android:ems="10"
                    android:inputType="text"
                    android:text="mensaje a enviar" />

            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>